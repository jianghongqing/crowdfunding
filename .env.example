# ---- Database ----
MYSQL_ROOT_PASSWORD=crowdfunding
MYSQL_DATABASE=crowdfunding
# MySQL is intentionally not exposed by docker-compose.yml.
# For local debugging, expose it via a compose override bound to 127.0.0.1.
DATABASE_URL=root:crowdfunding@tcp(mysql:3306)/crowdfunding?charset=utf8mb4&parseTime=true
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# ---- API Server ----
# Bind API to localhost by default; expose it publicly through nginx/frontend.
API_PORT=127.0.0.1:8080
API_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Chain Config ----
CHAIN_CONFIG_HOST_PATH=./backend/config/chain.testnet.example.json
